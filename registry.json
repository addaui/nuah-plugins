            "type": "string",
            "x-apply": "service",
            "x-tier": "bootstrap"
          },
          "token": {
            "description": "Require `Authorization: Bearer <token>` (give it as a reference, {\"$env\": \"NAME\"}, to keep it out of the Profile)",
            "minLength": 8,
            "type": "string",
            "x-apply": "service",
            "x-secret": true,
            "x-tier": "operator"
          }
        },
        "type": "object"
      },
      "version": "0.1.0"
