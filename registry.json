      "kind": "plugin",
      "name": "Appearance",
      "operations": [
        "appearance.get",
        "appearance.reset",
        "appearance.save",
        "appearance.schema"
      ],
      "provides": [
        {
          "extension_point": "prefs.item",
          "optional": true,
          "priority": 0
        }
      ],
      "requires": {
        "capabilities": [
          "emit"
        ],
        "extension_points": [],
        "plugins": [],
        "ports": []
      },
      "settings_schema": null,
      "version": "0.1.0"
    },
    {
      "crate": "nuah-emoji",
      "defines": [
        "emoji.set"
      ],
