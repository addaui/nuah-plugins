      "id": "@nuah/emoji",
      "kind": "plugin",
      "name": "Emoji",
      "operations": [
        "emoji.asset",
        "emoji.catalog",
        "emoji.sets"
      ],
      "provides": [
        {
          "extension_point": "emoji.set",
          "optional": true,
          "priority": 0
        },
        {
          "extension_point": "prefs.item",
          "optional": true,
          "priority": 0
        }
      ],
      "requires": {
        "capabilities": [
          "call"
        ],
        "extension_points": [
          "emoji.set"
        ],
        "plugins": [],
        "ports": []
      },
      "settings_schema": null,
      "version": "0.1.0"
    },
    {
      "crate": "nuah-gifs",
      "defines": [
        "gifs.provider"
      ],
      "description": "Where a Face finds GIFs: asks the enabled GIF provider plugin how to call it from the browser",
      "fills": null,
      "id": "@nuah/gifs",
      "kind": "plugin",
      "name": "GIFs",
      "operations": [
        "gifs.provider"
      ],
      "provides": [],
      "requires": {
        "capabilities": [],
