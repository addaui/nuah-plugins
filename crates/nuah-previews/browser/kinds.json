{
 "kinds": [
  {
   "kind": "@nuah/previews/link-card",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "Link preview",
    "ar": "معاينة رابط"
   },
   "icon": "bookmark",
   "group": "embed",
   "keywords": "url bookmark link card",
   "nodes": [
    "linkPreview"
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "url"
     ],
     "additionalProperties": false,
     "properties": {
      "url": {
       "type": "string",
       "maxLength": 2000,
       "description": "The web address"
      },
      "title": {
       "type": "string",
       "maxLength": 300
      },
      "description": {
       "type": "string",
       "maxLength": 1000
      },
      "mode": {
       "enum": [
        "card",
        "compact",
        "stack",
        "side"
       ]
      }
     }
    },
    "node": {
     "type": "linkPreview",
     "attrs": {
      "url": {
       "$": "url"
      },
      "title": {
       "$": "title"
      },
      "description": {
       "$": "description"
      },
      "mode": {
       "$": "mode",
       "default": "card"
      }
     }
    }
   },
   "options": [
    {
     "id": "mode",
     "type": "choice",
     "attr": "mode",
     "pinned": true,
     "default": "card",
     "label": {
      "en": "Layout",
      "ar": "التخطيط"
     },
     "choices": [
      {
       "value": "card",
       "label": {
        "en": "card"
       }
      },
      {
       "value": "compact",
       "label": {
        "en": "compact"
       }
      },
      {
       "value": "stack",
       "label": {
        "en": "stack"
       }
      },
      {
       "value": "side",
       "label": {
        "en": "side"
       }
      }
     ]
    }
   ]
  },
  {
   "kind": "@nuah/previews/youtube",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "YouTube",
    "ar": "يوتيوب"
   },
   "icon": "video",
   "group": "embed",
   "keywords": "video youtube",
   "nodes": [
    "youtube"
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "url"
     ],
     "additionalProperties": false,
     "properties": {
      "url": {
       "type": "string",
       "maxLength": 2000,
       "description": "The YouTube address"
      },
      "start": {
       "type": "number",
       "minimum": 0,
       "maximum": 86400,
       "description": "Where it starts, in seconds"
      }
     }
    },
    "node": {
     "type": "youtube",
     "attrs": {
      "src": {
       "$": "url"
      },
      "start": {
       "$": "start",
       "default": 0
      }
     }
    }
   },
   "options": [
    {
     "id": "size",
     "type": "choice",
     "attr": "size",
     "inherit": true,
     "pinned": true,
     "label": {
      "en": "Size",
      "ar": "الحجم"
     },
     "choices": [
      {
       "value": "small",
       "label": {
        "en": "small"
       }
      },
      {
       "value": "medium",
       "label": {
        "en": "medium"
       }
      },
      {
       "value": "wide",
       "label": {
        "en": "wide"
       }
      },
      {
       "value": "full",
       "label": {
        "en": "full"
       }
      }
     ]
    },
    {
     "id": "ratio",
     "type": "choice",
     "attr": "ratio",
     "inherit": true,
     "label": {
      "en": "Shape",
      "ar": "الشكل"
     },
     "choices": [
      {
       "value": "16-9",
       "label": {
        "en": "16-9"
       }
      },
      {
       "value": "4-3",
       "label": {
        "en": "4-3"
       }
      },
      {
       "value": "1-1",
       "label": {
        "en": "1-1"
       }
      }
     ]
    },
    {
     "id": "start",
     "type": "number",
     "attr": "start",
     "min": 0,
     "max": 86400,
     "unit": "s",
     "label": {
      "en": "Starts at",
      "ar": "يبدأ عند"
     },
     "default": 0
    }
   ]
  }
 ]
}
