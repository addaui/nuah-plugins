{
 "kinds": [
  {
   "kind": "@nuah/notebook/cell",
   "version": 1,
   "shape": "card",
   "placement": "block",
   "label": {
    "en": "Code cell",
    "ar": "خلية شيفرة"
   },
   "icon": "code",
   "group": "code",
   "keywords": "python notebook run code cell jupyter",
   "state": "text",
   "accepts": [
    ".py",
    "text/x-python"
   ],
   "schema": {
    "type": "object",
    "properties": {
     "language": {
      "enum": [
       "python"
      ]
     },
     "view": {
      "enum": [
       "both",
       "code",
       "output"
      ]
     },
     "output": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string",
        "maxLength": 100000
       },
       "files": {
        "type": "array",
        "maxItems": 20,
        "items": {
         "type": "string"
        }
       },
       "hash": {
        "type": "string"
       },
       "at": {
        "type": "number"
       },
       "ok": {
        "type": "boolean"
       }
      }
     }
    }
   }
  }
 ]
}
