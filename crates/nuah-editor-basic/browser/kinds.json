     "attr": "tone",
     "pinned": true,
     "label": {
      "en": "Kind",
      "ar": "النوع"
     },
     "default": "info",
     "choices": [
      {
       "value": "info",
       "label": {
        "en": "Info",
        "ar": "معلومة"
       }
      },
      {
       "value": "tip",
       "label": {
        "en": "Tip",
        "ar": "نصيحة"
       }
      },
      {
       "value": "warning",
       "label": {
        "en": "Warning",
        "ar": "تحذير"
       }
      },
      {
       "value": "danger",
       "label": {
        "en": "Danger",
        "ar": "خطر"
       }
      }
     ]
    }
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "title": {
       "type": "string",
       "maxLength": 20000,
       "description": "Its title, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
      },
      "text": {
       "type": "string",
       "maxLength": 20000,
       "description": "What it says, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
      },
      "tone": {
       "enum": [
        "info",
        "tip",
        "warning",
        "danger"
       ]
      }
     }
    },
    "node": {
     "type": "callout",
     "attrs": {
