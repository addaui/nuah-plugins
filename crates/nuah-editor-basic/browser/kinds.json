       "$": "tone",
       "default": "info"
      }
     },
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "$text": "title"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "$text": "text"
        }
       ]
      }
     ]
    }
