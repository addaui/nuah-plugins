  {
   "kind": "@nuah/editor-basic/toggle",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "Toggle",
    "ar": "قسم قابل للطي"
   },
   "group": "layout",
   "icon": "toggle",
   "keywords": "collapse fold details",
   "nodes": [
    "toggle"
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "summary"
     ],
     "additionalProperties": false,
     "properties": {
      "summary": {
       "type": "string",
       "maxLength": 20000,
       "description": "What shows when it is folded, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
      },
      "text": {
       "type": "string",
       "maxLength": 20000,
       "description": "What it holds, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
      }
     }
    },
    "node": {
     "type": "toggle",
     "attrs": {
      "open": true
