  {
   "kind": "@nuah/editor-basic/bullet-list",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "Bullet list",
    "ar": "قائمة نقطية"
   },
   "group": "list",
   "icon": "list-bullet",
   "keywords": "ul unordered",
   "nodes": [
    "bulletList",
    "listItem"
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 500,
       "items": {
        "type": "string",
        "maxLength": 20000,
        "description": "An item, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
       }
      }
     }
    },
    "node": {
     "type": "bulletList",
     "content": [
      {
       "$each": "items",
       "as": {
        "type": "listItem",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "$text": "."
           }
          ]
         }
        ]
       }
      }
     ]
    }
   }
  },
  {
   "kind": "@nuah/editor-basic/ordered-list",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "Numbered list",
    "ar": "قائمة مرقمة"
   },
   "group": "list",
   "icon": "list-ordered",
   "keywords": "ol ordered",
   "nodes": [
    "orderedList"
   ],
   "options": [
    {
     "id": "start",
     "type": "number",
     "attr": "start",
     "label": {
      "en": "Starts at",
      "ar": "يبدأ من"
     },
     "min": 1,
     "max": 9999,
     "default": 1
    }
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 500,
       "items": {
        "type": "string",
        "maxLength": 20000,
        "description": "An item, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
       }
      },
      "start": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9999
      }
     }
    },
    "node": {
     "type": "orderedList",
     "attrs": {
      "start": {
       "$": "start",
       "default": 1
      }
     },
     "content": [
      {
       "$each": "items",
       "as": {
        "type": "listItem",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "$text": "."
           }
          ]
         }
        ]
       }
      }
     ]
    }
   }
  },
  {
   "kind": "@nuah/editor-basic/checklist",
   "version": 1,
   "shape": "content",
   "placement": "block",
   "label": {
    "en": "Checklist",
    "ar": "قائمة مهام"
   },
   "group": "list",
   "icon": "list-check",
   "keywords": "todo check task",
   "nodes": [
    "taskList",
    "taskItem"
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 500,
       "items": {
        "type": "object",
        "required": [
         "text"
        ],
        "additionalProperties": false,
        "properties": {
         "text": {
          "type": "string",
          "maxLength": 20000,
          "description": "The item, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
         },
         "done": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "node": {
     "type": "taskList",
     "content": [
      {
       "$each": "items",
       "as": {
        "type": "taskItem",
        "attrs": {
         "checked": {
          "$": "done",
          "default": false
         }
        },
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "$text": "text"
           }
          ]
         }
        ]
       }
      }
     ]
    }
   }
  },
