    "paragraph"
   ],
   "options": [
    {
     "id": "align",
     "type": "choice",
     "attr": "align",
     "label": {
      "en": "Alignment",
      "ar": "المحاذاة"
     },
     "choices": [
      {
       "value": "start",
       "label": {
        "en": "start"
       }
      },
      {
       "value": "center",
       "label": {
        "en": "center"
       }
      },
      {
       "value": "end",
       "label": {
        "en": "end"
       }
      },
      {
       "value": "justify",
       "label": {
        "en": "justify"
       }
      }
     ]
    }
   ],
   "input": {
    "schema": {
     "type": "object",
     "required": [
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "text": {
       "type": "string",
       "maxLength": 20000,
       "description": "The text, inline Markdown: **bold**, *italic*, ~~strike~~, `code`, [text](address); a new line is a line break"
      },
      "align": {
       "enum": [
        "start",
        "center",
        "end",
        "justify"
       ]
      }
     }
    },
    "node": {
     "type": "paragraph",
     "attrs": {
      "align": {
       "$": "align"
      }
     },
     "content": [
      {
       "$text": "text"
      }
     ]
    }
   }
  },
  {
