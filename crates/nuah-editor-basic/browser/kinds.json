     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string",
       "maxLength": 100000,
       "description": "The code, as it is"
      },
      "language": {
       "type": "string",
       "maxLength": 40,
       "description": "Its language, for highlighting (python, rust, json, ...)"
      }
     }
    },
    "node": {
     "type": "codeBlock",
     "attrs": {
      "language": {
       "$": "language"
      }
     },
     "content": [
      {
       "$plain": "code"
      }
